# Macro file for the visualization setting in the initialization phase
# of the B1 example when running in interactive mode
#

# Use this open statement to create a view. The drivers Geant4 offers - OGL, OI, DAWNFILE,
# HepRepFile, VRML2FILE, TSG_OFFSCREEN - are one driver here: the viewer in
# src/render/vis_manager.cu, which any of those names selects. The geometry string is
# honoured.
/vis/open OGL 1280x800
#
# Disable auto refresh and quieten vis messages whilst scene and
# trajectories are established:
/vis/viewer/set/autoRefresh false
/vis/verbose errors
#
# Draw geometry:
/vis/drawVolume
#
# Specify view angle:
/vis/viewer/set/viewpointThetaPhi 70 20
#
# Specify zoom value:
/vis/viewer/zoom 1.4
#
# Specify style (surface, wireframe, auxiliary edges,...)
/vis/viewer/set/style surface
/vis/viewer/set/auxiliaryEdge true
/vis/viewer/set/lineSegmentsPerCircle 100
#
# Draw smooth trajectories at end of event, showing trajectory points
# as markers 2 pixels wide:
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByCharge
/vis/modeling/trajectories/drawByCharge-0/default/setDrawStepPts true
/vis/modeling/trajectories/drawByCharge-0/default/setStepPtsSize 2
#
# To superimpose all of the events from a given run:
/vis/scene/endOfEventAction accumulate
#
# Colour trajectories by particle species rather than by charge:
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set gamma green
/vis/modeling/trajectories/drawByParticleID-0/set e- red
/vis/modeling/trajectories/drawByParticleID-0/set e+ blue
#
# The world is left invisible so that the envelope and the two shapes inside it can be seen:
/vis/geometry/set/visibility World 0 false
#
# Re-establish auto refreshing and verbosity:
/vis/viewer/set/autoRefresh true
/vis/verbose warnings
#
# The gun, so that pressing Run in the control bar fires what the example fires:
/gun/particle gamma
/gun/energy 6 MeV
# No cross-section here. B1's PrimaryGeneratorAction draws its own beam spot per event, as
# Geant4's does, and SetParticlePosition means exactly that position - so a cross-section set
# here would be cleared each event anyway. It was not always: while the generator used the
# gun's cross-section instead of drawing, this line made the viewer fire what the example
# fires. Left in afterwards it randomised the spot a second time, and pressing Run gave 287 pGy
# where the same example in batch gave 429. See tests/test_gun_position.cu.
